{
  "name": "launched-bot",
  "version": "1.0.0",
  "description": "Discord Bot companion for Launched",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "deploy:commands": "tsx scripts/deploy-commands.ts",
    "deploy:commands:global": "tsx scripts/deploy-commands.ts --global",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
