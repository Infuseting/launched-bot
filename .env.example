# ==============================================================================
# DISCORD BOT - CONFIGURATION ENV
# ==============================================================================

# [OBLIGATOIRE] Token de votre Bot Discord (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# [OBLIGATOIRE] Application ID / Client ID de votre Bot Discord (Discord Developer Portal > General Information)
DISCORD_ID=

# [OBLIGATOIRE] Connexion MongoDB
# Par défaut, pointe vers le conteneur MongoDB Docker défini dans compose.yaml :
MONGO_TOKEN=mongodb://admin:changethispassword123@mongodb:27017/discordbot?authSource=admin

# Identifiants de la base de données MongoDB du conteneur Docker
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changethispassword123
MONGO_INITDB_DATABASE=discordbot

# [OBLIGATOIRE] Webhook de logs Discord (créez un webhook dans un salon de logs privé sur votre serveur)
# Format URL Webhook : https://discord.com/api/webhooks/<WEBHOOK_ID>/<WEBHOOK_TOKEN>
WEBHOOK_ID=
WEBHOOK_TOKEN=

# [OPTIONNEL] Clé API Giphy (gratuite sur https://developers.giphy.com)
GIPHY_TOKEN=

# ==============================================================================
# VARIABLES OPTIONNELLES
# ==============================================================================
DISCORD_STATUS="Listening to commands | /help"
RADIO=
TOPGG_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LAVALINK_HOST=lava.link
LAVALINK_PASSWORD=I'm a secret
LAVALINK_PORT=80
LAVALINK_SECURE=false
OPENAI=
