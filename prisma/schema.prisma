datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// Multi-Guild Tenant Configuration
// ---------------------------------------------------------------------------

model TicketGuildConfig {
  guildId               String   @id // Discord Guild Snowflake
  ticketChannelId       String   // Salon texte où sont créés les fils privés
  logChannelId          String?  // Salon des logs et transcripts
  supportRoleId         String?  // Rôle support par défaut
  adminRoleId           String?  // Rôle administrateur des tickets (/ticket-admin)
  ticketCounter         Int      @default(0) // Compteur séquentiel (#0001, #0002, ...)
  maxOpenTicketsPerUser Int      @default(3) // Limite de tickets ouverts simultanément
  dmTranscript          Boolean  @default(true) // Envoi du transcript en MP au créateur
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  categories TicketCategory[]
  panels     TicketPanel[]
  tickets    Ticket[]
  auditLogs  AuditLog[]

  @@map("ticket_guild_configs")
}

// ---------------------------------------------------------------------------
// Ticket Categories & Dynamic Question Forms
// ---------------------------------------------------------------------------

model TicketCategory {
  id            String   @id @default(uuid())
  guildId       String
  name          String   @db.VarChar(50)
  description   String?  @db.VarChar(100)
  emoji         String?  @db.VarChar(32)
  ticketPrefix  String   @default("ticket") @db.VarChar(15) // ex: "tech" -> tech-0042
  supportRoleId String?  // Rôle support dédié à cette catégorie (optionnel)
  order         Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  guild     TicketGuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  questions TicketQuestion[]
  tickets   Ticket[]

  @@unique([guildId, name])
  @@index([guildId, isActive])
  @@map("ticket_categories")
}

enum QuestionStyle {
  SHORT
  PARAGRAPH
}

model TicketQuestion {
  id          String        @id @default(uuid())
  categoryId  String
  label       String        @db.VarChar(45) // Limite Discord label de champ modal
  placeholder String?       @db.VarChar(100)
  style       QuestionStyle @default(PARAGRAPH)
  required    Boolean       @default(true)
  minLength   Int?          @default(0)
  maxLength   Int?          @default(1000)
  order       Int           @default(1) // 1 à 5 (limite stricte Discord de 5 champs par modal)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, order])
  @@map("ticket_questions")
}

// ---------------------------------------------------------------------------
// Interactive Panels
// ---------------------------------------------------------------------------

enum PanelType {
  BUTTON
  SELECT_MENU
}

model TicketPanel {
  id          String    @id @default(uuid())
  guildId     String
  channelId   String
  messageId   String    @unique
  title       String    @db.VarChar(100)
  description String    @db.VarChar(2000)
  type        PanelType @default(SELECT_MENU)
  buttonLabel String?   @db.VarChar(80)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  guild TicketGuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, channelId])
  @@map("ticket_panels")
}

// ---------------------------------------------------------------------------
// Ticket Operational Lifecycle
// ---------------------------------------------------------------------------

enum TicketStatus {
  OPEN
  CLAIMED
  CLOSED
  ARCHIVED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Ticket {
  id             String         @id @default(uuid())
  guildId        String
  number         Int            // Numéro séquentiel au sein du serveur (#0001, etc.)
  threadId       String         @unique // Snowflake du Thread Privé Discord
  categoryId     String
  creatorId      String         // Snowflake Discord de l'auteur
  claimedById    String?        // Snowflake Discord du membre du staff ayant pris en charge
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(NORMAL)
  topic          String?        @db.VarChar(255)
  closedById     String?
  closeReason    String?        @db.VarChar(500)
  closedAt       DateTime?
  participants   String[]       @default([]) // Liste des IDs des membres ajoutés au thread
  formAnswers    Json           @default("[]") // [{ question: string, answer: string }]
  transcriptUrl  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  guild    TicketGuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  category TicketCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([guildId, number])
  @@index([guildId, status])
  @@index([creatorId, status])
  @@map("tickets")
}

// ---------------------------------------------------------------------------
// Audit Log Schema (Prêt pour le futur système /logs-admin)
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  guildId   String
  subsystem String   @db.VarChar(32) // "TICKETS", "MODERATION", etc.
  action    String   @db.VarChar(64) // "TICKET_CREATED", "TICKET_CLOSED", etc.
  actorId   String   // User ID de l'auteur de l'action
  targetId  String?  // Target User ou Thread ID
  metadata  Json     @default("{}")  // Données contextuelles
  timestamp DateTime @default(now())

  guild TicketGuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, subsystem, action])
  @@index([guildId, timestamp])
  @@map("audit_logs")
}
